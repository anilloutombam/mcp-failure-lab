{
  "name": "mcp-failure-lab",
  "version": "0.1.0",
  "description": "A chaos-engineering and resilience testing toolkit for MCP servers.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc",
    "start": "node dist/cli.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "testing",
    "chaos-engineering",
    "resilience"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  }
}
