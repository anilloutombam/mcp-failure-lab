{
  "name": "mcp-failure-lab",
  "version": "0.13.2",
  "mcpName": "io.github.anilloutombam/mcp-failure-lab",
  "description": "Deterministic fault-injection server for testing how MCP clients handle failures and recover.",
  "type": "module",
  "bin": {
    "mcp-failure-lab": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anilloutombam/mcp-failure-lab.git"
  },
  "bugs": {
    "url": "https://github.com/anilloutombam/mcp-failure-lab/issues"
  },
  "homepage": "https://github.com/anilloutombam/mcp-failure-lab#readme",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit && tsc --project tests/tsconfig.json",
    "build": "npm run clean && tsc",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "start": "node dist/cli.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "registry:sync": "node scripts/sync-registry-version.mjs",
    "registry:validate": "npm run registry:sync && mcp-publisher validate",
    "observatory:prepare": "node scripts/prepare-observatory-report.mjs",
    "observatory:validate": "node scripts/validate-observatory-manifest.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "package:validate": "node scripts/validate-package-contents.mjs",
    "release:verify": "npm run format:check && npm run typecheck && npm test && npm run build && npm run package:validate && npm run audit:prod",
    "prepublishOnly": "npm run release:verify"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "testing",
    "chaos-engineering",
    "fault-injection",
    "resilience"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/core": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  }
}
